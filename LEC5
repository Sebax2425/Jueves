package Dinamico;
/**
 *
 * @author sebastian
 */
public class PilaDinamica {
    private Nodo cima;
    
    public PilaDinamica(){
        this.cima = null;
    }
    
    public void push(int dato){
        Nodo nuevoNodo = new Nodo(dato);
        nuevoNodo.setSiguiente(cima);
        cima = nuevoNodo;
    }
    
    public int pop(){
        if(cima == null){
            System.out.println("Pila vacia");
            return -1;
        } 
        int dato = cima.getDato();
        cima = cima.getSiguiente();
        return dato;
    }
    
    public void mostrar(){
        if(cima == null){
            System.out.println("Pila vacia");
            return;
        }
        Nodo actual = cima;
        System.out.println("Contenido de pila");
        while(actual != null){
            System.out.println(actual.getDato());
            actual = actual.getSiguiente();
        }
    }
    
    public int size(){
        if(cima == null){
            return 0;
        }
        Nodo actual = cima;
        int contador = 0;
        while(actual != null){
            contador++;
            actual = actual.getSiguiente();
        }
        return contador;
    }
    
    
}
