public class ListaDoble {
    private NodoDoble cabeza;
    private NodoDoble ultimo;

    public ListaDobleCircular() {
        this.cabeza = null;
        this.ultimo = null;
    }

    // a) size()
    public int size() {
        if (esVacia()) return 0;
        int count = 1;
        NodoDoble actual = cabeza.siguiente;
        while (actual != cabeza) {
            count++;
            actual = actual.siguiente;
        }
        return count;
    }

    // b) esVacia()
    public boolean esVacia() {
        return cabeza == null;
    }

    // c) existe(valor)
    public boolean existe(int valor) {
        if (esVacia()) return false;
        NodoDoble actual = cabeza;
        do {
            if (actual.dato == valor) return true;
            actual = actual.siguiente;
        } while (actual != cabeza);
        return false;
    }

    // d) valorEn(índice)
    public int valorEn(int indice) {
        if (indice < 0) throw new IndexOutOfBoundsException();
        NodoDoble actual = cabeza;
        for (int i = 0; i < indice; i++) {
            actual = actual.siguiente;
            if (actual == cabeza) throw new IndexOutOfBoundsException();
        }
        return actual.dato;
    }

    // e) insertarAlFrente(valor)
    public void insertarAlFrente(int valor) {
        NodoDoble nuevo = new NodoDoble(valor);
        if (esVacia()) {
            cabeza = nuevo;
            ultimo = nuevo;
            nuevo.siguiente = nuevo;
            nuevo.anterior = nuevo;
        } else {
            nuevo.siguiente = cabeza;
            nuevo.anterior = ultimo;
            cabeza.anterior = nuevo;
            ultimo.siguiente = nuevo;
            cabeza = nuevo;
        }
    }

    // f) insertarAlFinal(valor)
    public void insertarAlFinal(int valor) {
        NodoDoble nuevo = new NodoDoble(valor);
        if (esVacia()) {
            cabeza = nuevo;
            ultimo = nuevo;
            nuevo.siguiente = nuevo;
            nuevo.anterior = nuevo;
        } else {
            nuevo.siguiente = cabeza;
            nuevo.anterior = ultimo;
            ultimo.siguiente = nuevo;
            cabeza.anterior = nuevo;
            ultimo = nuevo;
        }
    }

    // g) removerFrente()
    public int removerFrente() {
        if (esVacia()) throw new RuntimeException("Lista vacía");
        int valor = cabeza.dato;
        if (cabeza == ultimo) {
            cabeza = null;
            ultimo = null;
        } else {
            NodoDoble temp = cabeza;
            cabeza = cabeza.siguiente;
            cabeza.anterior = ultimo;
            ultimo.siguiente = cabeza;
            temp.siguiente = null;
            temp.anterior = null;
        }
        return valor;
    }

    // h) removerFinal()
    public int removerFinal() {
        if (esVacia()) throw new RuntimeException("Lista vacía");
        int valor = ultimo.dato;
        if (cabeza == ultimo) {
            cabeza = null;
            ultimo = null;
        } else {
            NodoDoble temp = ultimo;
            ultimo = ultimo.anterior;
            ultimo.siguiente = cabeza;
            cabeza.anterior = ultimo;
            temp.siguiente = null;
            temp.anterior = null;
        }
        return valor;
    }

    // i) removerValor(valor)
    public void removerValor(int valor) {
        if (esVacia()) return;
        NodoDoble actual = cabeza;
        do {
            if (actual.dato == valor) {
                if (actual == cabeza) {
                    removerFrente();
                } else if (actual == ultimo) {
                    removerFinal();
                } else {
                    actual.anterior.siguiente = actual.siguiente;
                    actual.siguiente.anterior = actual.anterior;
                }
                return;
            }
            actual = actual.siguiente;
        } while (actual != cabeza);
    }

    // j) eliminar(índice)
    public void eliminar(int indice) {
        if (indice < 0 || esVacia()) throw new IndexOutOfBoundsException();
        NodoDoble actual = cabeza;
        for (int i = 0; i < indice; i++) {
            actual = actual.siguiente;
            if (actual == cabeza) throw new IndexOutOfBoundsException();
        }
        if (actual == cabeza) {
            removerFrente();
        } else if (actual == ultimo) {
            removerFinal();
        } else {
            actual.anterior.siguiente = actual.siguiente;
            actual.siguiente.anterior = actual.anterior;
        }
    }

    // k) frente()
    public int frente() {
        if (esVacia()) throw new RuntimeException("Lista vacía");
        return cabeza.dato;
    }

    // l) atrás()
    public int atras() {
        if (esVacia()) throw new RuntimeException("Lista vacía");
        return ultimo.dato;
    }

    // m) insertar(índice, valor)
    public void insertar(int indice, int valor) {
        if (indice < 0) throw new IndexOutOfBoundsException();
        if (indice == 0) {
            insertarAlFrente(valor);
            return;
        }
        if (indice == size()) {
            insertarAlFinal(valor);
            return;
        }
        NodoDoble nuevo = new NodoDoble(valor);
        NodoDoble actual = cabeza;
        for (int i = 0; i < indice; i++) {
            actual = actual.siguiente;
            if (actual == cabeza) throw new IndexOutOfBoundsException();
        }
        nuevo.siguiente = actual;
        nuevo.anterior = actual.anterior;
        actual.anterior.siguiente = nuevo;
        actual.anterior = nuevo;
    }

    // n) reversar()
    public void reversar() {
        if (esVacia() || size() == 1) return;
        NodoDoble actual = cabeza;
        NodoDoble temp;
        do {
            temp = actual.siguiente;
            actual.siguiente = actual.anterior;
            actual.anterior = temp;
            actual = temp;
        } while (actual != cabeza);
        temp = cabeza;
        cabeza = ultimo;
        ultimo = temp;
    }
}



